---
import Base from '../layouts/Base.astro';
import { reader } from '../lib/reader.js';

const page = await reader.singletons.elopementsPage.read();
const pricing = await reader.singletons.pricingPage.read();
const carouselImgs = page.carouselImages ?? [];
const galleryImgs = page.galleryImages ?? [];
---

<Base
  title="Your Adventure — Elopements · Michael Hutcheon Photography"
  description="Elopement photography in the Great Smoky Mountains and beyond. Intimate, unhurried, and entirely yours — by Knoxville-based photographer Michael Hutcheon."
  activePage="elopements"
>

  <!-- ============================================================
       HERO CAROUSEL
       ============================================================ -->
  <section class="carousel" aria-label="Elopement photography slideshow">
    <div class="carousel__track">
      {carouselImgs.length > 0 ? carouselImgs.map((item, i) => (
        <div class={`carousel__slide${i === 0 ? ' is-active' : ''}`} aria-hidden={i !== 0 ? 'true' : 'false'}>
          <div class="carousel__img"
            style={`background-image: url('${item.src}'); background-size: cover; background-position: ${item.focal ?? 'center'};`}></div>
        </div>
      )) : (
        <>
          <div class="carousel__slide is-active" aria-hidden="false">
            <div class="carousel__img cs1"></div>
          </div>
          <div class="carousel__slide" aria-hidden="true">
            <div class="carousel__img cs2"></div>
          </div>
          <div class="carousel__slide" aria-hidden="true">
            <div class="carousel__img cs3"></div>
          </div>
        </>
      )}
    </div>

    <div class="carousel__dots" role="tablist" aria-label="Slides">
      {(carouselImgs.length > 0 ? carouselImgs : [0, 1, 2]).map((_, i) => (
        <button
          class={`carousel__dot${i === 0 ? ' is-active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>

    <div class="carousel__content">
      <p class="carousel__eyebrow">{page.heroEyebrow}</p>
      <h1 class="carousel__title">{page.heroTitle}</h1>
      <p class="carousel__sub">{page.heroSub}</p>
    </div>

    <p class="carousel__location">{page.heroLocation}</p>
  </section>

  <!-- ============================================================
       PAGE INTRO
       ============================================================ -->
  <section class="intro">
    <div class="container">
      <div class="intro__inner reveal">
        <div class="intro__meta">
          <p class="intro__eyebrow">Elopements</p>
        </div>
        <div class="intro__copy">
          <p class="intro__text">{page.introText}</p>
          <p class="intro__sig">&mdash; {page.introSig}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       GALLERY
       ============================================================ -->
  {galleryImgs.length > 0 && (
    <section class="gallery">
      <div class="gallery__dynamic">
        <div class="gallery__col">
          {galleryImgs.map((item, i) => (i % 4 === 0 || i % 4 === 3) ? (
            <div class="g-img"
              data-lightbox-src={item.src}
              data-lightbox-title={item.title ?? ''}
              style={`order: ${i}; background-image: url('${item.src}'); background-size: cover; background-position: ${item.focal ?? 'center'}; aspect-ratio: ${item.orientation === 'landscape' ? '4/3' : '3/4'};`}
              aria-label="Elopement photo"></div>
          ) : null)}
        </div>
        <div class="gallery__col">
          {galleryImgs.map((item, i) => (i % 4 === 1 || i % 4 === 2) ? (
            <div class="g-img"
              data-lightbox-src={item.src}
              data-lightbox-title={item.title ?? ''}
              style={`order: ${i}; background-image: url('${item.src}'); background-size: cover; background-position: ${item.focal ?? 'center'}; aspect-ratio: ${item.orientation === 'landscape' ? '4/3' : '3/4'};`}
              aria-label="Elopement photo"></div>
          ) : null)}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================
       WHAT TO EXPECT
       ============================================================ -->
  <section class="expect">
    <div class="container">

      <header class="expect__head reveal">
        <p class="expect__eyebrow">{page.expectEyebrow}</p>
        <h2 class="expect__title">{page.expectTitle}</h2>
      </header>

      <div class="expect__grid">
        {page.expectSteps.map((step, i) => (
          <article class="expect-step reveal" data-delay={i + 1}>
            <span class="expect-step__num">{step.number}</span>
            <h3 class="expect-step__title">{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============================================================
       INTRO
       ============================================================ -->
  <section class="pricing-intro">
    <div class="container">
      <div class="pricing-intro__inner reveal">
        <p class="pricing-intro__eyebrow">{pricing.introEyebrow}</p>
        <p class="pricing-intro__statement">{pricing.introStatement}</p>
        <p class="pricing-intro__body">{pricing.introBody}</p>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============================================================
       PACKAGES
       ============================================================ -->
  <section class="packages">
    <div class="packages__grid">
      {pricing.packages.map((pkg, i) => (
        <div class={`package${pkg.featured ? ' package--featured' : ''} reveal`} data-delay={i}>
          <div class="package__head">
            <p class="package__name">{pkg.name}</p>
            <p class="package__price">{pkg.price}</p>
          </div>
          <p class="package__desc">{pkg.description}</p>
          <ul class="package__list">
            {pkg.features.map(f => <li>{f}</li>)}
          </ul>
          <a href="/contact" class="package__cta">Enquire →</a>
        </div>
      ))}
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============================================================
       ALWAYS INCLUDED
       ============================================================ -->
  <section class="inclusions">
    <div class="container">
      <div class="inclusions__inner reveal">
        <div class="inclusions__label">
          <p class="inclusions__eyebrow">Always Included</p>
        </div>
        <ul class="inclusions__list">
          {pricing.alwaysIncluded.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============================================================
       ADD-ONS
       ============================================================ -->
  <section class="addons">
    <div class="container">
      <div class="addons__inner reveal">
        <div class="addons__label">
          <p class="addons__eyebrow">Add-Ons</p>
        </div>
        <div class="addons__copy">
          <p class="addons__text">{pricing.addOnsParagraph1}</p>
          <p class="addons__text">{pricing.addOnsParagraph2}</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============================================================
       CTA
       ============================================================ -->
  <section class="cta">
    <div class="container">
      <p class="cta__eyebrow">{page.ctaEyebrow}</p>
      <h2 class="cta__title" set:html={page.ctaTitle}></h2>
      <p class="cta__sub">{page.ctaSub}</p>
      <a href="/contact" class="btn-primary">Get in Touch</a>
    </div>
  </section>

</Base>

<style>
/* ── Carousel ─────────────────────────────────────────────── */
.carousel {
  position: relative;
  height: 65vh;
  min-height: 380px;
  overflow: hidden;
}

.carousel::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 80%;
  background: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(14,14,13,0.30) 40%,
    rgba(14,14,13,0.70) 70%,
    rgba(14,14,13,0.88) 100%
  );
  z-index: 2;
  pointer-events: none;
}

.carousel__track { position: absolute; inset: 0; }

.carousel__slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1.4s ease-in-out;
}
.carousel__slide.is-active { opacity: 1; }

.carousel__img {
  width: 100%;
  height: 100%;
}

/* Placeholder gradients — replaced via CMS */
.cs1 {
  background:
    linear-gradient(to bottom, rgba(14,14,13,0.2) 0%, rgba(14,14,13,0.5) 100%),
    linear-gradient(165deg, #1a2818 0%, #2a3820 35%, #1e2c18 65%, #141e10 100%);
}
.cs2 {
  background:
    linear-gradient(to bottom, rgba(14,14,13,0.15) 0%, rgba(14,14,13,0.55) 100%),
    linear-gradient(155deg, #261e10 0%, #342614 35%, #2a2010 65%, #1e1808 100%);
}
.cs3 {
  background:
    linear-gradient(to bottom, rgba(14,14,13,0.2) 0%, rgba(14,14,13,0.5) 100%),
    linear-gradient(170deg, #141828 0%, #1c2434 35%, #141e2c 65%, #0e1420 100%);
}

.carousel__dots {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  z-index: 3;
}

.carousel__dot {
  width: 32px;
  height: 2px;
  background: rgba(240,236,228,0.3);
  border: none;
  padding: 8px 0;
  background-clip: content-box;
  cursor: pointer;
  transition: background-color var(--t-mid);
}
.carousel__dot.is-active { background-color: var(--text-primary); }

.carousel__content {
  position: absolute;
  bottom: 3rem;
  left: 0;
  right: 0;
  z-index: 3;
  padding-right: var(--gutter);
  padding-left: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
}

.carousel__eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.carousel__title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 300;
  line-height: 1.05;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.carousel__sub {
  font-family: var(--font-display);
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-style: italic;
  color: var(--text-secondary);
}

.carousel__location {
  position: absolute;
  bottom: 2rem;
  right: var(--gutter);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
  z-index: 3;
}

@media (max-width: 768px) {
  .carousel__location { display: none; }
}

/* ── Intro ────────────────────────────────────────────────── */
.intro { padding-block: var(--space-xl); }

.intro__inner {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 4rem;
  align-items: start;
}

.intro__eyebrow {
  font-size: 0.6rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  padding-top: 0.6rem;
}

.intro__title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 300;
  line-height: 1.05;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.intro__sub {
  font-family: var(--font-display);
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-style: italic;
  color: var(--text-secondary);
  margin-bottom: 2rem;
}

.intro__text {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 1.8vw, 1.45rem);
  font-weight: 300;
  line-height: 1.65;
  color: var(--text-primary);
  margin-bottom: 1.5rem;
}

.intro__sig {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1.1rem;
  color: var(--text-secondary);
}

@media (max-width: 768px) {
  .intro__inner {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

/* ── Gallery ──────────────────────────────────────────────── */
.gallery { padding-block: var(--space-xl); }

.gallery__dynamic {
  display: flex;
  gap: 6px;
  padding-left: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
  padding-right: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
}

.gallery__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.g-img {
  display: block;
  width: 100%;
  cursor: pointer;
}

@media (max-width: 600px) {
  .gallery__dynamic {
    flex-direction: column;
  }
  .gallery__col {
    display: contents;
  }
}

/* ── What to Expect ───────────────────────────────────────── */
.expect { padding-block: var(--space-xl); }

.expect__head { margin-bottom: var(--space-lg); }

.expect__eyebrow {
  font-size: 0.6rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.expect__title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 300;
  line-height: 1.15;
  color: var(--text-primary);
}

.expect__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rem;
  align-items: start;
}

.expect-step__num {
  display: block;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: var(--accent);
  margin-bottom: 1.25rem;
}

.expect-step__title {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--text-primary);
  margin-bottom: 1rem;
  font-style: italic;
}

.expect-step p {
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--text-secondary);
}

@media (max-width: 768px) {
  .expect__grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
}

/* ── Intro ────────────────────────────────────────────────── */
.pricing-intro {
  padding-block: var(--space-xl);
}

.pricing-intro__eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1.5rem;
}

.pricing-intro__statement {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2.2vw, 1.7rem);
  font-weight: 300;
  line-height: 1.55;
  color: var(--text-primary);
  margin-bottom: 1.25rem;
}

.pricing-intro__body {
  font-size: 0.92rem;
  line-height: 1.85;
  color: var(--text-secondary);
}

/* ── Packages ─────────────────────────────────────────────── */
.packages {
  padding-block: var(--space-xl);
}

.packages__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  padding-inline: var(--gutter);
  background: var(--bg);
}

.package {
  background: var(--bg);
  padding: 2.5rem 2.75rem 2.75rem;
  display: flex;
  flex-direction: column;
}

.package--featured {
  background: var(--surface);
}

.package__head {
  margin-bottom: 1.5rem;
}

.package__name {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 2.5vw, 2.2rem);
  font-weight: 300;
  color: var(--text-primary);
  margin-bottom: 0.35rem;
}

.package__price {
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  color: var(--accent);
}

.package__desc {
  font-size: 0.88rem;
  line-height: 1.75;
  color: var(--text-secondary);
  margin-bottom: 1.75rem;
  padding-bottom: 1.75rem;
  border-bottom: 1px solid var(--border);
}

.package__list {
  list-style: none;
  padding: 0;
  margin: 0 0 2rem;
  flex: 1;
}

.package__list li {
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--text-secondary);
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border);
  padding-left: 1rem;
  position: relative;
}
.package__list li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--text-dim);
  font-size: 0.7rem;
}

.package__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-top: auto;
  transition: color var(--t-fast);
}
.package__cta:hover { color: var(--accent); }

@media (max-width: 900px) {
  .packages__grid {
    grid-template-columns: 1fr;
    background: var(--bg);
    gap: var(--space-md);
  }
  .package {
    border: 1px solid var(--border);
  }
  .package--featured {
    border-color: var(--accent);
  }
}

/* ── Always Included ──────────────────────────────────────── */
.inclusions {
  padding-block: var(--space-xl);
}

.inclusions__inner {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 5rem;
  align-items: start;
}

.inclusions__eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  padding-top: 0.3rem;
}

.inclusions__list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.inclusions__list li {
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--text-secondary);
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--border);
  padding-left: 1rem;
  position: relative;
}
.inclusions__list li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--text-dim);
  font-size: 0.7rem;
}
.inclusions__list li:first-child {
  border-top: 1px solid var(--border);
}

@media (max-width: 768px) {
  .inclusions__inner {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

/* ── Add-ons ──────────────────────────────────────────────── */
.addons {
  padding-block: var(--space-xl);
}

.addons__inner {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 5rem;
  align-items: start;
}

.addons__eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  padding-top: 0.3rem;
}

.addons__text {
  font-size: 0.92rem;
  line-height: 1.85;
  color: var(--text-secondary);
  max-width: 580px;
}
.addons__text + .addons__text {
  margin-top: 1.2rem;
}

@media (max-width: 768px) {
  .addons__inner {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

/* ── CTA ──────────────────────────────────────────────────── */
.cta {
  padding-block: var(--space-xl) var(--space-2xl);
  text-align: center;
}

.cta__eyebrow {
  font-size: 0.75rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1.5rem;
}

.cta__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 300;
  line-height: 1.15;
  color: var(--text-primary);
  margin-bottom: 1rem;
}
.cta__title em {
  font-style: italic;
  color: var(--accent);
}

.cta__sub {
  font-size: 0.95rem;
  color: var(--text-secondary);
  margin-bottom: 2.5rem;
}

.btn-primary {
  display: inline-block;
  padding: 0.85rem 2.5rem;
  border: 1px solid var(--accent);
  color: var(--accent);
  font-family: var(--font-body);
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  transition: background var(--t-fast), color var(--t-fast);
}
.btn-primary:hover {
  background: var(--accent);
  color: var(--bg);
}
</style>

<script>
  // Carousel
  (function () {
    const slides = Array.from(document.querySelectorAll('.carousel__slide'));
    const dots   = Array.from(document.querySelectorAll('.carousel__dot'));
    if (!slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(idx: number) {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      dots[current].classList.remove('is-active');
      dots[current].setAttribute('aria-selected', 'false');
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      slides[current].setAttribute('aria-hidden', 'false');
      dots[current].classList.add('is-active');
      dots[current].setAttribute('aria-selected', 'true');
    }

    const start = () => { timer = setInterval(() => goTo(current + 1), 5500); };
    const reset = () => { clearInterval(timer); start(); };

    dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); reset(); }));

    const carousel = document.querySelector('.carousel');
    carousel?.addEventListener('mouseenter', () => clearInterval(timer));
    carousel?.addEventListener('mouseleave', start);

    start();
  })();

  // Scroll reveals
  (function () {
    const els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    els.forEach(el => obs.observe(el));
  })();
</script>
