---
import Base from '../layouts/Base.astro';
import { reader } from '../lib/reader.js';

const page = await reader.singletons.contactPage.read();
const heroBg = (img) => img?.src
  ? `background: linear-gradient(to bottom, rgba(14,14,13,0.15) 0%, rgba(14,14,13,0.08) 40%, rgba(14,14,13,0.55) 80%, rgba(14,14,13,0.92) 100%), url('${img.src}') ${img.focal ?? 'center'}/cover no-repeat;`
  : undefined;
---

<Base
  title="Contact — Michael Hutcheon Photography"
  description="Get in touch with Michael Hutcheon. Elopement enquiries, adventure photography, and everything in between."
  activePage="contact"
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero">
    <div class="hero__image" style={heroBg(page.heroImage)} aria-hidden="true"></div>
    <p class="hero__location">{page.heroLocation}</p>
    <div class="hero__content">
      <p class="hero__eyebrow">{page.heroEyebrow}</p>
      <h1 class="hero__title">{page.heroTitle}</h1>
      <p class="hero__sub">{page.heroSub}</p>
    </div>
  </section>

  <!-- ============================================================
       FORM
       ============================================================ -->
  <section class="contact-section">
    <div class="container">

      <form class="contact-form reveal" id="contact-form" novalidate>

        <div class="form-row form-row--half">
          <div class="form-field">
            <label class="form-label" for="name">Name</label>
            <input
              class="form-input"
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="email">Email</label>
            <input
              class="form-input"
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <div class="form-row form-row--half">
          <div class="form-field">
            <label class="form-label" for="date">Date <span class="form-label__note">or rough timeframe</span></label>
            <input
              class="form-input"
              type="text"
              id="date"
              name="date"
              placeholder="e.g. October 2025, sometime next spring"
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="location">Location <span class="form-label__note">where are you thinking?</span></label>
            <input
              class="form-input"
              type="text"
              id="location"
              name="location"
              placeholder="e.g. Smoky Mountains, Blue Ridge Parkway"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="referral">How did you hear about me?</label>
            <input
              class="form-input"
              type="text"
              id="referral"
              name="referral"
              placeholder="e.g. a friend, Instagram, Google"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="message">Tell me about your plans</label>
            <textarea
              class="form-input form-input--textarea"
              id="message"
              name="message"
              rows="5"
              placeholder="Whatever feels relevant — who you are, what you're planning, what you're after."
              required
            ></textarea>
          </div>
        </div>

        <div class="form-actions">
          <button class="btn-submit" type="submit">Submit</button>
        </div>

      </form>

      <div class="contact-thanks" id="contact-thanks" aria-live="polite">
        <p class="contact-thanks__eyebrow">{page.thankYouEyebrow}</p>
        <p class="contact-thanks__message">{page.thankYouMessage}</p>
      </div>

    </div>
  </section>

</Base>

<style>
/* ── Hero ─────────────────────────────────────────────────── */
.hero {
  position: relative;
  height: 50vh;
  min-height: 380px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.hero__image {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom,
      rgba(14,14,13,0.15) 0%,
      rgba(14,14,13,0.08) 40%,
      rgba(14,14,13,0.55) 80%,
      rgba(14,14,13,0.92) 100%
    ),
    linear-gradient(160deg, #181814 0%, #221e18 30%, #2a2820 55%, #1c1a14 75%, #101008 100%);
}
.hero__image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 55%, rgba(200,169,110,0.09) 0%, transparent 55%);
}

.hero__location {
  position: absolute;
  bottom: 2rem;
  right: var(--gutter);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
  z-index: 2;
}

.hero__content {
  position: relative;
  z-index: 2;
  padding-top: 0;
  padding-right: var(--gutter);
  padding-bottom: 3rem;
  padding-left: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
}

.hero__eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 300;
  line-height: 1.05;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.hero__sub {
  font-family: var(--font-display);
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-style: italic;
  color: var(--text-secondary);
}

@media (max-width: 768px) {
  .hero__location { display: none; }
}

/* ── Contact Section ──────────────────────────────────────── */
.contact-section {
  padding-block: var(--space-xl) var(--space-2xl);
}

/* ── Form ─────────────────────────────────────────────────── */
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
  max-width: 560px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}

.form-row--half {
  flex-direction: row;
  gap: 1.5rem;
}
.form-row--half .form-field {
  flex: 1;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.form-label {
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.form-label__note {
  color: var(--text-dim);
  text-transform: none;
  letter-spacing: 0;
  font-size: 0.7rem;
}

.form-input {
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 0.9rem;
  line-height: 1.6;
  padding: 0.6rem 0;
  transition: border-color var(--t-fast);
  outline: none;
  width: 100%;
}
.form-input::placeholder {
  color: var(--text-dim);
  font-size: 0.82rem;
}
.form-input:focus {
  border-bottom-color: var(--accent);
}

.form-input--textarea {
  resize: vertical;
  min-height: 120px;
}

.form-actions {
  padding-top: 0.5rem;
}

.btn-submit {
  display: inline-block;
  padding: 0.85rem 2.5rem;
  border: 1px solid var(--accent);
  background: var(--accent);
  color: var(--bg);
  font-family: var(--font-body);
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
}
.btn-submit:hover {
  background: var(--text-primary);
  border-color: var(--text-primary);
  color: var(--bg);
}

/* ── Thank-you state ──────────────────────────────────────── */
.contact-thanks {
  display: none;
  padding-block: var(--space-md);
}
.contact-thanks.is-visible {
  display: block;
}

.contact-thanks__eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.contact-thanks__message {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  font-weight: 300;
  color: var(--text-primary);
}

@media (max-width: 600px) {
  .form-row--half {
    flex-direction: column;
  }
  .contact-form {
    max-width: 100%;
  }
}
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if (els.length) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    els.forEach(el => obs.observe(el));
  }

  const form = document.getElementById('contact-form');
  const thanks = document.getElementById('contact-thanks');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.style.display = 'none';
    thanks?.classList.add('is-visible');
  });
</script>
